:root{--bg:#f4f7f6;--surface:#fff;--ink:#12343b;--muted:#4d6b70;--accent:#0f766e;--accent-ink:#fff;--line:#d3e0dd;--warn:#b42318;--ok:#166534;color-scheme:light}
:root[data-tema="escuro"]{--bg:#0d1f23;--surface:#142c31;--ink:#e8f1ef;--muted:#9fb8b4;--accent:#5eead4;--accent-ink:#0d1f23;--line:#26454b;--warn:#ff8a80;--ok:#86efac;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;font:1rem/1.65 "Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--ink)}
h1,h2{font-family:Georgia,"Times New Roman",serif;line-height:1.2}
h1{font-size:clamp(1.9rem,5vw,2.8rem);margin:0 0 .6rem}
h2{font-size:1.35rem;margin:1.8rem 0 .5rem}
a{color:var(--accent)}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.topo{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem 1.4rem;padding:.9rem 1.2rem;background:var(--surface);border-bottom:1px solid var(--line)}
.marca{font:700 1.2rem Georgia,serif;text-decoration:none;color:var(--ink)}
.topo nav{display:flex;flex-wrap:wrap;gap:.3rem 1rem;margin-left:auto}
.topo nav a{text-decoration:none;color:var(--muted);padding:.2rem 0;border-bottom:2px solid transparent}
.topo nav a:hover,.topo nav a[aria-current]{color:var(--ink);border-bottom-color:var(--accent)}
main{max-width:760px;margin:0 auto;padding:2rem 1.2rem 3rem}
.hero{padding:2rem 0 1rem}.hero p{max-width:60ch;color:var(--muted);font-size:1.1rem}
.bloco{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:1.5rem;margin-top:1.2rem}
.ajuda{color:var(--muted);font-size:.92rem;margin:.2rem 0 .8rem}
button{font:inherit;cursor:pointer;border:0;border-radius:6px;padding:.55rem 1.1rem;background:var(--accent);color:var(--accent-ink);font-weight:600}
button:hover{filter:brightness(1.1)}
button.secundario,#btn-tema{background:transparent;color:var(--ink);border:1px solid var(--line)}
input,select,textarea{font:inherit;width:100%;padding:.55rem .7rem;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink)}
.linha{display:flex;gap:.6rem}
.campo{margin-bottom:1rem}.campo label{display:block;font-weight:600;margin-bottom:.25rem}
.campo.invalido input,.campo.invalido select,.campo.invalido textarea{border-color:var(--warn)}
.erro{display:block;color:var(--warn);min-height:1.1em;font-size:.88rem}
.feedback{min-height:1.4em;font-weight:600}.feedback.ok{color:var(--ok)}.feedback.erro-msg{color:var(--warn)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.metas,.lista{list-style:none;padding:0;margin:.8rem 0}
.metas li{display:flex;align-items:center;gap:.7rem;padding:.55rem 0;border-bottom:1px solid var(--line)}
.metas li.feita span{text-decoration:line-through;color:var(--muted)}
.metas input{width:auto}.metas span{flex:1}
.metas button{padding:.25rem .6rem;background:transparent;color:var(--warn);border:1px solid var(--line)}
.lista li{padding:.6rem 0;border-bottom:1px solid var(--line)}
.tags{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;padding:0}
.tags li{background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:.2rem .8rem}
.video{position:relative;aspect-ratio:16/9}.video iframe{position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:8px}
audio,img{max-width:100%}img{height:auto;border-radius:8px}
.grafico{display:grid;gap:.7rem;margin:1rem 0}
.barra{display:grid;grid-template-columns:100px 1fr 44px;align-items:center;gap:.6rem}
.barra .trilho{background:var(--bg);border:1px solid var(--line);border-radius:6px;height:22px;overflow:hidden}
.barra .preenche{height:100%;background:var(--accent);width:0;transition:width .8s ease}
.tabela{width:100%;border-collapse:collapse;margin-top:1rem}
.tabela th,.tabela td{text-align:left;padding:.4rem;border-bottom:1px solid var(--line)}
.rodape{text-align:center;color:var(--muted);padding:1.5rem;border-top:1px solid var(--line);font-size:.9rem}
@media(max-width:560px){.linha{flex-direction:column}.topo nav{margin-left:0}.barra{grid-template-columns:80px 1fr 40px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
